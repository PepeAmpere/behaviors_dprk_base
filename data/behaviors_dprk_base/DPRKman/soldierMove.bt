{
  "name": "Root",
  "id": "0f4c961c-cce4-4d00-9f0d-fc785a0d1648",
  "type": "supervisedParallel",
  "subtrees": [
    {
      "name": "Logic",
      "id": "1c2b5911-e21f-4386-85f0-3ff2fff36548",
      "type": "selector",
      "subtrees": [
        {
          "name": "<unnamed>",
          "id": "a4ea5060-ecce-4799-9c66-68abb4f64694",
          "type": "reference",
          "decorators": [
            {
              "id": "933e3d7b-62d9-4fe2-b297-b9d02da57a35",
              "type": "scriptCondition",
              "name": "If we can see enemy in reactRadius distance",
              "script": [
                "local enemy = GetEnemyNearby(self, loc.reactRadius)",
                "",
                "if enemy == nil or not self:IsVisible(enemy) then",
                "    return false",
                "end",
                "",
                "",
                "",
                "arg.orderData.entityToFireAt = enemy",
                "",
                "return true"
              ]
            }
          ],
          "target": [
            "behaviors_dprk_base",
            "soldierFireAt"
          ],
          "arguments": {
            "orderData": "arg.orderData"
          }
        },
        {
          "name": "Move",
          "id": "f3dee67d-2d23-45dd-ab70-1d04298ef5b1",
          "type": "move",
          "position": [
            "return arg.orderData.destination"
          ]
        }
      ],
      "active": true
    },
    {
      "name": "Debug",
      "id": "f99adf6a-9d73-46d7-8886-006712621e3b",
      "type": "sequence",
      "subtrees": [
        {
          "name": "Draw Circle",
          "id": "1c78618e-0fbb-449f-b813-e19bba21f100",
          "type": "scriptAction",
          "script": [
            "for i = 0, math.pi * 2 - math.pi/12, math.pi/12 do",
            "    local pX = self:GetPosition():X() + (loc.reactRadius * math.sin(i))",
            "    local pY = self:GetPosition():Y() + (loc.reactRadius * math.cos(i))",
            "    local pZ = self:GetPosition():Z() + 1",
            "    local nextPX = self:GetPosition():X() + (loc.reactRadius * math.sin(i + math.pi/12))",
            "    local nextPY = self:GetPosition():Y() + (loc.reactRadius * math.cos(i + math.pi/12))",
            "    local nextPZ = self:GetPosition():Z() + 1",
            "",
            "    local p = Vec3(pX, pY, pZ)",
            "    local nextP = Vec3(nextPX, nextPY, nextPZ)",
            "",
            "    DebugLine(p, nextP, 1, 1, 1, 1)",
            "end"
          ]
        }
      ],
      "decorators": [
        {
          "id": "1635e344-e3db-48e9-a8e1-ea104f607fcb",
          "type": "loopForever",
          "name": "Loop"
        }
      ]
    }
  ],
