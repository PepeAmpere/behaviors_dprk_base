          }
        ],
        "editorObjects": []
      },
      "script": [
        "local orderData = {}",
        "orderData.orderName = \"OccupyMaty\"",
        "",
        "for i, sI in pairs(loc.firstTeam) do",
        "    orderData.position = self:GetEntity(sI):GetPosition()",
        "    self:SendMessage(self:GetEntity(sI), \"NewOrder\", orderData)",
        "end",
        "",
        "loc.firstPolyChanged = false"
      ]
    },
