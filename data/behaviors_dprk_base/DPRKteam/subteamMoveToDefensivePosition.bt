{
  "name": "Parallel",
  "id": "7eecd028-bf5a-41b6-a8c8-0a439388668b",
  "type": "supervisedParallel",
  "subtrees": [
    {
      "name": "Root",
      "id": "f18bc06f-8a3e-4548-86da-655d3b0925ba",
      "type": "sequence",
      "subtrees": [
        {
          "name": "AssignCoverCenter",
          "id": "b8add01e-da3c-449d-bd59-d3ea6820b09c",
          "type": "scriptAction",
          "script": [
            "loc.coverPosition = arg.orderData.position"
          ]
        },
        {
          "name": "FindCovers",
          "id": "dae81ccc-2b9a-43e6-ae4f-6593284b8ac5",
          "type": "scriptAction",
          "script": [
            "local groupPos = {}",
            "local entitiesCount = self:GetEntityCount()",
            "local validIndex = 1",
            "",
            "for i = 0, entitiesCount - 1 do",
            "    local soldier = self:GetEntity(i)",
            "",
            "    if soldier ~= nil and soldier:IsAlive() then",
            "        groupPos[validIndex] = arg.orderData.position",
            "        validIndex = validIndex + 1",
            "    end",
            "end",
            "",
            "local threats = {}",
            "",
            "if validIndex > 1 then",
            "    if arg.orderData.threatPosition ~= nil and arg.orderData.threatPosition:Norm() > 0.01 then",
            "",
            "        local threatDirection = (groupPos[1] - arg.orderData.threatPosition):Normalized()",
            "        loc.threatDirectionPos = arg.orderData.position + (30 * threatDirection)",
            "        table.insert(threats, { position = loc.threatDirectionPos, avoidance = 1.0 })",
            "    end",
            "",
            "    local params = {",
            "        weights = { distance = -2, protection = 10, preferenceTowardThreats = 0.6 },",
            "        constraints = { coneOfFire = 15 }",
            "    }",
            "",
            "    loc.futureCovers = FindCovers(threats, Circle(arg.orderData.position, loc.coverSearchRadius), groupPos, params)",
            "end"
          ]
        },
        {
          "name": "isCoverReady",
          "id": "4e31b308-411f-4cc2-8e3e-da0260bbf64d",
          "type": "waitUntil",
          "condition": [
            "return loc.futureCovers ~= nil and loc.futureCovers:IsReady()"
          ]
        },
        {
          "name": "Make OrderData",
          "id": "6dd5a92d-40a5-4767-92ff-28a01015c6d4",
          "type": "scriptAction",
          "script": [
            "loc.Covers = loc.futureCovers:Value()",
            "",
            "loc.subOrderData = {",
            "    orderName = \"MoveMudrak\",",
            "    destination = arg.orderData.position",
            "}",
            "",
            "loc.subordinates = {}",
            "loc.subordinateData = InternalTable()",
            "local entitiesCount = self:GetEntityCount()",
            "local coverIndex = 1",
            "",
            "for i = 0, entitiesCount - 1 do",
            "    local soldier = self:GetEntity(i)",
            "",
            "    if soldier ~= nil and soldier:IsAlive() then",
            "        table.insert(loc.subordinates, soldier)",
            "",
            "        local targetPos = arg.orderData.position",
            "",
            "        if loc.Covers and loc.Covers[coverIndex] then",
            "            targetPos = loc.Covers[coverIndex].position",
            "        end",
            "",
            "        loc.subordinateData[soldier] = {",
            "            orderName = \"MoveMudrak\",",
            "            destination = targetPos,",
            "        }",
            "",
            "        coverIndex = coverIndex + 1",
            "    end",
            "end"
          ]
        },
        {
          "name": "InfantryMan Move To Position",
          "id": "6eaa11b5-6b35-4306-858b-1c6b0d00c3e2",
          "type": "reference",
          "target": [
            "standard_behaviors",
            "ExecuteSubordinateOrder"
          ],
          "arguments": {
            "orderData": "return loc.subOrderData",
            "subordinates": "return loc.subordinates",
            "subordinateData": "return loc.subordinateData",
            "update": "return false"
          }
        }
      ]
    },
    {
      "name": "Debug",
      "id": "e4c3c7a8-400d-4331-bac2-f0c7449a207c",
      "type": "sequence",
      "subtrees": [
        {
          "name": "Draw destinations",
          "id": "8cacb7f8-24be-4d05-9f00-a8f23a089e78",
          "type": "scriptAction",
          "script": [
            "if loc.subordinates ~= nil and loc.subordinateData ~= nil and loc.subOrderData ~= nil then",
            "    -- Original destination (the center point of the order)",
            "    local startDest = loc.subOrderData.destination",
            "    local startTop = startDest + Vec3(0, 0, 15) -- 15 meters up",
            "",
            "    -- Draw the central pillar (Cyan)",
            "    DebugLine(startDest, startTop, 0, 1, 1, 1)",
            "",
            "    for _, soldier in ipairs(loc.subordinates) do",
            "        if soldier ~= nil and soldier:IsAlive() then",
            "            local data = loc.subordinateData[soldier]",
            "",
            "            if data ~= nil and data.destination ~= nil then",
            "                local foundDest = data.destination",
            "                local foundTop = foundDest + Vec3(0, 0, 15) -- 15 meters up",
            "",
            "                -- Draw a vertical line from the cover destination (Yellow)",
            "                DebugLine(foundDest, foundTop, 1, 1, 0, 1)",
            "",
            "                -- Draw a connecting line between the tops (Magenta)",
            "                DebugLine(startTop, foundTop, 1, 0, 1, 1)",
            "            end",
            "        end",
            "    end",
            "end",
            "",
            "if loc.threatDirectionPos ~= nil then",
            "    DebugLine(loc.threatDirectionPos, loc.threatDirectionPos + Vec3(0, 0, 15), 1, 0, 0, 1)",
            "end"
          ]
        }
      ],
      "decorators": [
        {
          "id": "2f7d014a-0c0e-4e55-b95e-2c58e8bf2add",
          "type": "loopForever",
          "name": "Loop"
        }
      ]
    }
  ],
  "meta": {
